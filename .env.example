# ---- ShareHub configuration ----
# Copy to .env and edit. Used by the server, the website build, and the desktop app.

# Server port
PORT=3000

# Public URLs (used for links, the desktop app, and cross-origin connects)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# --- exposed to the website build (Vite needs the VITE_ prefix) ---
# Where the browser opens its WebSocket. Leave blank to use the same origin the site is served from.
VITE_BACKEND_URL=

# TURN relay (recommended for connections between different networks).
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
