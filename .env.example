# ---- ShareHub configuration ----
# Copy to .env and edit. Used by the server, the website build, and the desktop app.

# Server port
PORT=3000

# Public URLs (used for links, the desktop app, and cross-origin connects)
FRONTEND_URL=https://text.ipoup.in
BACKEND_URL=https://api.text.ipoup.in
# Where the Download buttons send users when no local installer file is present:
RELEASES_URL=https://github.com/mkuser608/text-share1/releases/latest

# --- exposed to the website build (Vite needs the VITE_ prefix) ---
# Where the browser opens its WebSocket.
#  - Leave BLANK if one server serves both (npm run build && npm start, or one domain).
#  - Set to the API origin ONLY if you host the frontend separately from the backend.
VITE_BACKEND_URL=
# Where the Download buttons send users when no local installer file is present:
RELEASES_URL=https://github.com/mkuser608/text-share1/releases/latest

# TURN relay (strongly recommended for connections between different networks).
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
