# ---- ShareHub configuration ----
# Copy to .env and edit. Used by the server, the website build, and the desktop app.

# Server port (the Node server serves the built frontend + backend/WebSocket)
PORT=3000

# Where the Download buttons send users when no local installer is present
RELEASES_URL=https://github.com/mkuser608/text-share1/releases/latest

# =====================================================================
# Pick ONE of the two deployment options below and fill it in.
# =====================================================================

# ---- OPTION 1: one domain for everything (simplest) ----
# The Node server serves the frontend AND the backend/WS on the same origin.
#   FRONTEND_URL=https://text.ipoup.in
#   BACKEND_URL=https://text.ipoup.in
#   VITE_BACKEND_URL=            <-- leave BLANK (frontend uses same origin)
# (No api. subdomain needed.)

# ---- OPTION 2: two subdomains (frontend + backend separate) ----
# Host the built dist/ at FRONTEND_URL; run the Node backend at BACKEND_URL.
#   FRONTEND_URL=https://text.ipoup.in
#   BACKEND_URL=https://api.text.ipoup.in
#   VITE_BACKEND_URL=https://api.text.ipoup.in   <-- the DIFFERENT backend origin

# ---- Active values (edit these) ----
FRONTEND_URL=https://text.ipoup.in
BACKEND_URL=https://api.text.ipoup.in
# BLANK = same-origin (Option 1). Set to the API origin for Option 2.
VITE_BACKEND_URL=

# For local testing (npm run build && npm start on one machine): keep
# VITE_BACKEND_URL blank so the frontend talks to your local server.

# TURN relay (strongly recommended for control between different networks)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
